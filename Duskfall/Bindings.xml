<Bindings>
  <Binding name="DUSKFALL_TOGGLE" category="Duskfall" runOnUp="false">
    Duskfall_ToggleEnabled()
  </Binding>
  <Binding name="DUSKFALL_COMPARE" category="Duskfall" runOnUp="true">
    Duskfall_Compare(keystate)
  </Binding>
  <Binding name="DUSKFALL_PEEK" category="Duskfall" runOnUp="true">
    Duskfall_Peek(keystate)
  </Binding>
</Bindings>
